# ==============================================================================
# Brew & Boba Café — Docker Environment Configuration (.env.example)
# Copy this file to .env before running docker compose
# ==============================================================================

# Project Name for Docker Compose
COMPOSE_PROJECT_NAME=brew-and-boba

# Host Port Bindings
FRONTEND_PORT=5173
BACKEND_PORT=8001
POSTGRES_HOST_PORT=5432

# PostgreSQL Configuration
POSTGRES_DB=coffee_shop
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here

# Backend Configuration
JWT_SECRET=your_at_least_32_character_jwt_secret_here
JWT_EXPIRES_IN=7d
USD_TO_KHR_RATE=4100
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Default Seed Administrator Credentials
ADMIN_INITIAL_EMAIL=admin@coffeeshop.com
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here
ADMIN_INITIAL_NAME=Store Administrator

# Frontend Configuration (Accessed by browser on host machine)
VITE_API_URL=http://localhost:8001
VITE_USD_TO_KHR=4100
