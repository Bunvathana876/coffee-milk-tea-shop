PORT=8001
ENVIRONMENT=development
DATABASE_URL=postgresql://postgres:your_password_here@localhost:5432/coffee_shop
JWT_SECRET=your_at_least_32_character_jwt_secret_here
JWT_EXPIRES_IN=7d
USD_TO_KHR_RATE=4100
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:5174,http://127.0.0.1:5175,http://127.0.0.1:3000
ADMIN_INITIAL_EMAIL=admin@coffeeshop.com
ADMIN_INITIAL_PASSWORD=your_secure_admin_password_here
ADMIN_INITIAL_NAME=Store Administrator

