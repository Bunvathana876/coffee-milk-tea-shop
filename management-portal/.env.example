# Local development proxy target. Docker integration sets this to http://backend:8000.
VITE_PROXY_TARGET=http://localhost:8001

# Production public API endpoint (e.g. Vercel deployment targeting Render staging).
# Leave unset in local development to use the same-origin Vite proxy.
# VITE_API_URL=https://brew-boba-cafe-api-staging.onrender.com
